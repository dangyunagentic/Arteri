# Arteri server config
PORT=8787
# Where the dashboard is publicly reachable (used on share pages). Leave empty to derive from request.
PUBLIC_BASE_URL=
# Console password. If unset, a random one is generated and printed ONCE on first boot.
ADMIN_PASSWORD=
# Optional static key for admin API scripting (header: x-admin-key)
ADMIN_API_KEY=
DATA_DIR=./data
